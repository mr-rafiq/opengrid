{
  "name": "@opengrid/react",
  "version": "0.1.0",
  "description": "Accessible, virtualized React adapter for OpenGrid",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes.css": "./dist/themes.css"
  },
  "dependencies": {
    "@opengrid/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const name of ['styles','themes']) require('node:fs').copyFileSync('src/'+name+'.css','dist/'+name+'.css')\"",
    "prepack": "node ../../scripts/package-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-rafiq/opengrid.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mr-rafiq/opengrid#readme"
}
