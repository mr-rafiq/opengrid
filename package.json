{
  "name": "opengrid-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @opengrid/core && npm run build -w @opengrid/react && npm run build -w @opengrid/export && npm run build -w opengrid-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "npm run dev -w opengrid-demo",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "node scripts/build-pages.mjs",
    "test:site": "playwright test --config examples/site/playwright.config.ts",
    "dev:site": "npm run dev -w opengrid-site"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.10.3",
    "exceljs": "^4.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "uuid": "11.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
